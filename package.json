{
  "name": "beyblade-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js --host",
    "preview:host": "vite preview --host --port 3000",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "demo": "node scripts/create-demo-arena.js",
    "test:e2e": "playwright test",
    "demo:features": "playwright test --config=playwright.demos.config.ts",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up app",
    "docker:typecheck": "docker compose run --rm typecheck",
    "docker:unit": "docker compose run --rm unit",
    "docker:dist": "docker compose run --rm dist",
    "docker:demos": "docker compose run --rm demos",
    "docker:test": "docker compose run --rm test",
    "docker:down": "docker compose down -v",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "phaser": "^3.80.0",
    "three": "^0.165.0",
    "three-mesh-bvh": "^0.9.16",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.184.1",
    "playwright": "^1.64.0",
    "puppeteer": "^25.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
