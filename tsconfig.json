{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    /* Supplies import.meta.env, used to strip the dev-only demo API from
       production builds. */
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "playwright.config.ts", "playwright.demos.config.ts"]
}
